<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_create_null_receipt_wizard" model="ir.ui.view">
        <field name="name">pos.nullreceipt.wizard.form</field>
        <field name="model">pos.nullreceipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Null Receipt">
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="create_receipt" string="Create" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
