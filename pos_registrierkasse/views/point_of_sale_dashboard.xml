<odoo>
    <data>
        <record id="view_pos_config_kanban_extension" model="ir.ui.view">
            <field name="name">pos.config.kanban.view.extension</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//t[@t-name='menu']/div/div" position="after">
                    <div class="row" style="min-width:200px" invisible="not pos_use_registrierkasse">
                        <div class="col-6 o_kanban_manage_view">
                            <h5 role="menuitem" class="o_kanban_card_manage_title">
                                <span>RKSV</span>
                            </h5>
                            <div role="menuitem">
                                <a name="action_create_nullreceipt" string="Create Null Receipt" type="object"/>
                                <a name="action_download_daten_erfassungs_protokoll" string="Data Recording Protocol" type="object"/>
                            </div>
                        </div>
                    </div>
                </xpath>
                <field name="currency_id" position="after">
                    <field name="pos_use_registrierkasse"/>
                    <field name="a_trust_environment"/>
                    <field name="unsigned_order_ids"/>
                </field>
                <field name="current_user_id" position="replace">
                    <div class="row g-0 pb-0 ms-2 mt-auto">
                        <div class="col-11">
                            <div t-if="record.pos_use_registrierkasse.raw_value and record.a_trust_environment.raw_value == 'production'" class="text-success fw-bold"
                                    title="This PoS is operating as an Austrian Cash Register according to RKSV.">RKSV Active</div>
                            <div t-if="record.pos_use_registrierkasse.raw_value and record.a_trust_environment.raw_value != 'production'" class="text-warning fw-bold"
                                    title="This PoS uses a test environment of the Austrian Cash Register.">RKSV Test</div>
                            <div t-if="record.unsigned_order_ids.raw_value.length > 0" class="badge text-bg-danger"
                                    title="There are unsigned orders from this PoS. This happens when the RKSV signing provider is not available at time of payment.">
                                <a name="action_view_unsigned_orders" type="object" class="text-white">Unsigned Orders</a>
                            </div>
                        </div>
                        <field name="current_user_id" widget="many2one_avatar_user" class="mt-auto ms-auto col-1"/>
                    </div>
                </field>
            </field>
        </record>
    </data>
</odoo>