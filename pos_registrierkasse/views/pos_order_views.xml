<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_registrierkasse" model="ir.ui.view">
        <field name="name">pos.order.form.registrierkasse</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_retry_signing" string="Retry Signing" type="object"
                    invisible="rksv_state != 'not_signed'"
                    groups="point_of_sale.group_pos_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_registrierkasse" model="ir.ui.view">
        <field name="name">pos.order.list.registrierkasse</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="registrierkasse_receipt_number" invisible="not registrierkasse_receipt_number" optional="hide" groups="base.group_no_one"/>
            </field>
            <field name="amount_total" position="after">
                <field name="sum_total_rksv" sum="Amount total" widget="monetary" invisible="rksv_state != 'signed'" optional="hide" groups="base.group_no_one"/>
            </field>
            <field name="state" position="after">
                <field name="rksv_state" widget="badge" optional="hide"
                    decoration-info="rksv_state == 'pending'" decoration-success="rksv_state == 'signed'" decoration-danger="rksv_state == 'not_signed'"/>
            </field>
        </field>
    </record>

    <record id="view_pos_pos_form_registrierkasse" model="ir.ui.view">
        <field name="name">pos.order.form.registrierkasse</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="failed_pickings" position="before">
                <widget name="web_ribbon" title="Not Signed" bg_color="bg-danger" invisible="rksv_state != 'not_signed'"/>
            </field>
            <xpath expr="//page[@name='extra']/group" position="inside">
                <group string="Cash Register" invisible="not rksv_state" groups="base.group_no_one">
                    <field name="rksv_state" decoration-success="rksv_state == 'signed'" decoration-danger="rksv_state == 'not_signed'"/>
                    <field name="registrierkasse_receipt_number"/>
                    <field string="VAT Normal" name="sum_vat_normal" widget="monetary"/>
                    <field string="VAT Discounted 1" name="sum_vat_discounted_1" widget="monetary"/>
                    <field string="VAT Discounted 2" name="sum_vat_discounted_2" widget="monetary"/>
                    <field string="VAT Null" name="sum_vat_null" widget="monetary"/>
                    <field string="VAT Special" name="sum_vat_special" widget="monetary"/>
                    <field string="Total Sum" name="sum_total_rksv" widget="monetary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter_registrierkasse" model="ir.ui.view">
        <field name="name">pos.order.list.select.registrierkasse</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <filter name="order_date" position="after">
                <separator/>
                <filter string="Missing RKSV Signature" name="not_signed" domain="[('rksv_state', '=', 'not_signed')]"/>
            </filter>
        </field>
    </record>
</odoo>
